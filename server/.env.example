# Copy this file to .env and fill in the values
# Never commit .env to git
#
# This file configures the server when it runs LOCALLY (npm run dev).
# The deployed Lambda does NOT read it - set those values in the Lambda console
# under Configuration -> Environment variables instead.

# AWS Region
# Local only: Lambda sets this itself and rejects it as a custom env var.
AWS_REGION=us-east-1

# AWS Cognito - get these from AWS Console after creating the User Pool
# User Pool ID format: us-east-1_XXXXXXXXX
COGNITO_USER_POOL_ID=us-east-1_XXXXXXXXX
# App Client ID (the client you created with no secret)
COGNITO_CLIENT_ID=XXXXXXXXXXXXXXXXXXXXXXXXXX

# AWS credentials - LOCAL DEVELOPMENT ONLY.
# The code never passes credentials explicitly, so the SDK uses the default
# provider chain: on Lambda that resolves to the LabRole execution role
# automatically, and these are not needed (Lambda reserves these names and
# will reject them). Running locally there is no role, so the SDK falls back
# to these. Use the temporary credentials from Learner Lab (AWS Details → Show);
# they expire when the lab session ends and must be re-copied each session.
# AWS_SESSION_TOKEN is required for Learner Lab temporary credentials.
AWS_ACCESS_KEY_ID=XXXXXXXXXXXXXXXXXXXX
AWS_SECRET_ACCESS_KEY=XXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX
AWS_SESSION_TOKEN=XXXXX...

# DynamoDB table names (must match tables created in AWS Console)
DYNAMODB_USERS_TABLE=Couplet-Users
DYNAMODB_COUPONS_TABLE=Couplet-Coupons
DYNAMODB_GROUPS_TABLE=Couplet-Groups
DYNAMODB_NOTIFICATIONS_TABLE=Couplet-Notifications
# Connections table for the WebSocket API (PK: connection_id, GSI: user_id-index)
DYNAMODB_CONNECTIONS_TABLE=Couplet-Connections

# WebSocket API (API Gateway). Used to push live notifications and to relay
# WebRTC signaling (SDP/ICE) between peers - coupon codes are NEVER sent over it.
# Either set WS_API_ENDPOINT directly, or set WS_API_ID + WS_STAGE to have it built.
# Endpoint format: https://<WS_API_ID>.execute-api.<AWS_REGION>.amazonaws.com/<WS_STAGE>
WS_API_ID=XXXXXXXXXX
WS_STAGE=prod
# WS_API_ENDPOINT=https://XXXXXXXXXX.execute-api.us-east-1.amazonaws.com/prod

# Encryption key for coupon codes stored as a fallback on notification rows
# (offline recipients, and the rescue path when a P2P transfer fails).
# Must be 32 random bytes, base64-encoded - generate with:
#   openssl rand -base64 32
# Required: sharing to an offline member throws without it. Must match the value
# set on the deployed Lambda, or codes written there cannot be decrypted.
NOTIFICATION_CODE_KEY=XXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX=

# Server port (optional, defaults to 3000)
PORT=3000

# Google Places API key - used for the "Where to use" store locator feature
# Get one at console.cloud.google.com → APIs & Services → Credentials → Create Credentials → API Key
# Enable "Places API" on the same project
GOOGLE_PLACES_API_KEY=YOUR_GOOGLE_PLACES_API_KEY

# Gmail coupon scanner - "native" OAuth client (Desktop app type) from console.cloud.google.com
# → APIs & Services → Credentials. Used by the Dev Client (custom-scheme redirect) connect flow.
# Same pattern as GOOGLE_PLACES_API_KEY above: plain Lambda env var, set directly in the Lambda console when deploying.
GOOGLE_CLIENT_ID=YOUR_GOOGLE_OAUTH_CLIENT_ID
GOOGLE_CLIENT_SECRET=YOUR_GOOGLE_OAUTH_CLIENT_SECRET

# Gmail coupon scanner - "web" OAuth client (Web application type), used by the Expo-Go-compatible
# browser-bridge connect flow (GET /gmail/callback). Needs its own client because only "Web
# application" type clients can register a plain https:// Authorized redirect URI in Google Console.
GOOGLE_WEB_CLIENT_ID=YOUR_GOOGLE_WEB_OAUTH_CLIENT_ID
GOOGLE_WEB_CLIENT_SECRET=YOUR_GOOGLE_WEB_OAUTH_CLIENT_SECRET
# Must exactly match the Authorized redirect URI registered on the web client above.
GOOGLE_WEB_REDIRECT_URI=https://<your-api-id>.execute-api.us-east-1.amazonaws.com/gmail/callback

# 32-byte key (base64) used to encrypt Gmail refresh tokens before they're stored in DynamoDB,
# and to sign the short-lived state token used by the browser-bridge connect flow above.
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
GMAIL_TOKEN_ENCRYPTION_KEY=YOUR_BASE64_32_BYTE_KEY

# DynamoDB table for the Gmail scanner (create manually in AWS Console, like the tables above)
DYNAMODB_GMAIL_CONNECTIONS_TABLE=Couplet-GmailConnections
